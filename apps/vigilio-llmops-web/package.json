    "react-hook-form": "7.54.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.2",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/preact": "3.2.4",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.8",
    "jsdom": "26.1.0",
    "msw": "2.7.3",
    "playwright": "^1.65.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "8.0.0",
