{
  "name": "@vigilio/llmops-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "start": "node dist/main.js api",
    "dev": "tsx watch src/main.ts api",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts test/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.integration.config.ts test/e2e",
    "test:bdd": "cucumber-js --config cucumber.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/main.ts migration",
    "db:seed:super": "tsx scripts/seed-super.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "pack:contracts": "node scripts/pack-contracts.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "governance:boundaries": "node scripts/check-boundaries.mjs",
    "verify:inventories": "node scripts/verify-inventories.mjs",
    "test:security": "vitest run --config vitest.integration.config.ts test/security",
    "test:endpoints": "node scripts/test-all-endpoints.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.11",
    "@nestjs/core": "11.1.11",
    "@nestjs/platform-express": "11.1.11",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/terminus": "11.0.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.67.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.214.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-node": "0.214.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "@scalar/nestjs-api-reference": "^1.2.35",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "nats": "2.29.3",
    "nodemailer": "7.0.10",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@cucumber/cucumber": "12.2.0",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/testing": "11.1.11",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.4",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.0.8",
    "drizzle-kit": "0.31.6",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
