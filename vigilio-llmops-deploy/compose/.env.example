# Vigilio LLMOps Platform — Parameterized Single-Compose Environment Template
# Copy to `compose/.env` (`chmod 0600 compose/.env`) and replace ALL `*_IMAGE` values
# with verified `@sha256:...` immutable digests before staging/production deployment.

COMPOSE_PROJECT_NAME=vigilio-llmops
CADDY_BIND_ADDRESS=0.0.0.0
SITE_ADDRESS=llmops.example.internal
SITE_ORIGIN=https://llmops.example.internal
WEB_ORIGIN=https://llmops.example.internal
GRAFANA_ALLOWED_CIDR=127.0.0.1/32

APP_NODE_ENV=production
SESSION_COOKIE_SECURE=true

# Database & Stateful Services (No host ports published; authenticated on internal `backend` network)
POSTGRES_USER=llmops
POSTGRES_DB=llmops
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg18
VALKEY_IMAGE=valkey/valkey:9.0.5-alpine
NATS_IMAGE=nats:2.12.3-alpine

# Edge, Frontend & Modular Monolith Backend
CADDY_IMAGE=caddy:2.10.2-alpine
BACKEND_IMAGE=vigilio/llmops-backend:local
WEB_IMAGE=vigilio/llmops-web:local

# Observability & Alerting Stack
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.141.0
ALLOY_IMAGE=grafana/alloy:v1.8.2
TEMPO_IMAGE=grafana/tempo:2.9.0
LOKI_IMAGE=grafana/loki:3.6.3
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1
GRAFANA_IMAGE=grafana/grafana:12.2.1
GF_SECURITY_ADMIN_USER=admin

# Disaster Recovery (`pgBackRest` Offsite S3 Encrypted Repository — never local VPS disk)
PGBACKREST_IMAGE=pgbackrest/pgbackrest:2.54.2
PGBACKREST_STANZA=llmops
PGBACKREST_REPO1_S3_ENDPOINT=s3.backups.example.internal
PGBACKREST_REPO1_S3_BUCKET=vigilio-llmops-pitr
PGBACKREST_REPO1_S3_REGION=us-east-1
PGBACKREST_REPO1_S3_KEY=replace-with-offsite-s3-access-key-id
PGBACKREST_BACKUP_INTERVAL_SECONDS=86400

# Supply-Chain Verification (Cosign Keyless OIDC / Public Key Policy)
COSIGN_CERTIFICATE_OIDC_ISSUER=https://token.actions.githubusercontent.com
COSIGN_CERTIFICATE_IDENTITY_REGEXP=^https://github\.com/Vigilio-Services/.*$
COSIGN_REQUIRE_ATTESTATION=true

# Outbound Integrations (`egress` network)
MODEL_BASE_URL=http://ollama:11434
SMTP_HOST=smtp.example.internal
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=no-reply@vigilio.invalid

# External opt-in Facebook Login (requires Meta configuration, callback and data-deletion URLs)
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_APP_ID=

# Optional profiles (`--profile models`, `--profile devtools` in isolated local labs ONLY)
OLLAMA_IMAGE=ollama/ollama:0.12.5
MAILPIT_IMAGE=axllent/mailpit:v1.27.8
