{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(vigilio_http_server_duration_milliseconds_count[5m]))",
          "legendFormat": "HTTP {{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "title": "Gateway & API Throughput (RPS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vigilio_http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vigilio_http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p50 Latency",
          "refId": "B"
        }
      ],
      "title": "Gateway & API Latency (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "max by (organization_id, workspace_id) (vigilio_finops_budget_utilization_ratio)",
          "legendFormat": "{{organization_id}}/{{workspace_id}}",
          "refId": "A"
        },
        {
          "expr": "sum(vigilio_finops_active_reservations_usd)",
          "legendFormat": "Active Reservations (USD)",
          "refId": "B"
        }
      ],
      "title": "FinOps Budget Utilization & Active Reservations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "vigilio_evaluation_active_runs",
          "legendFormat": "Active Evaluation Runs",
          "refId": "A"
        },
        {
          "expr": "avg(vigilio_evaluation_last_score)",
          "legendFormat": "Avg Evaluation Score",
          "refId": "B"
        }
      ],
      "title": "Evaluation Lifecycle (Active Runs & Scores)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 250 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "vigilio_outbox_pending_events",
          "legendFormat": "Outbox Pending Events",
          "refId": "A"
        },
        {
          "expr": "vigilio_dlq_messages_total",
          "legendFormat": "DLQ Messages",
          "refId": "B"
        }
      ],
      "title": "Transactional Outbox Backlog & DLQ",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "HEALTHY" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "up{job=~\"vigilio-api|otel-collector|prometheus|alertmanager|loki|tempo|alloy\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        },
        {
          "expr": "vigilio_process_uptime_seconds > bool 0",
          "legendFormat": "postgres/valkey/nats ready",
          "refId": "B"
        }
      ],
      "title": "Platform & Data Plane Health (PG / Valkey / NATS / OTel)",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vigilio", "llmops", "finops", "sre"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "utc",
  "title": "Vigilio LLMOps — Operational & FinOps Overview",
  "uid": "vigilio-llmops-overview",
  "version": 1
}
